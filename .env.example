NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/nexus-design
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# Contact form email notifications (via Resend)
RESEND_API_KEY=re_your_resend_api_key
NOTIFY_EMAIL=team@your-domain.com
# Use a verified Resend domain in production. Leave blank to use Resend's onboarding address for local testing.
RESEND_FROM=Nexus Design & Built <onboarding@resend.dev>
